### document_generator.py

from io import BytesIO
from docx import Document
from docx.shared import Pt


def create_docx(document_text, document_type):

    # Create a new Word document
    document = Document()

    # Title
    title = document.add_heading(
        "LegalEase",
        level=0
    )

    # Document type
    document.add_heading(
        document_type,
        level=1
    )

    # Add generated content
    paragraphs = document_text.split("\n")

    for paragraph in paragraphs:

        paragraph = paragraph.strip()

        if paragraph:
            p = document.add_paragraph(paragraph)

            for run in p.runs:
                run.font.size = Pt(11)

    # Disclaimer
    document.add_heading(
        "Disclaimer",
        level=2
    )

    document.add_paragraph(
        "This document was generated with the assistance of Artificial "
        "Intelligence. It is only a draft and does not constitute "
        "professional legal advice. Please consult a qualified legal "
        "professional before using this document for an actual legal purpose."
    )

    # Store document in memory
    file = BytesIO()

    document.save(file)

    file.seek(0)

    return file

